# Optional. Defaults to 0.0.0.0:8099
# BIND=127.0.0.1:8099

SEARXNG_URL=http://searxng:8080
# Supports: general, it, science, news
SEARXNG_CATEGORIES=general,it,science,news
SEARXNG_TIMEOUT_SECS=25
SEARXNG_CONCURRENCY=2
# space out requests to keep searxng happy
SEARXNG_MIN_INTERVAL_MS=1000

# Optional. Defaults to true, disable if you don't want it, or don't
# have the memory for it.
# EMBEDDING_ENABLED=false

# Supports: cpu, cuda, cuda:N
EMBEDDING_DEVICE=cuda
# Required when embeddings are enabled; EmbeddingGemma is gated.
HF_TOKEN=

# Optional. Without one, Stack Exchange's anonymous
# quota is much smaller; question and answer retrieval still works.
# STACKEXCHANGE_KEY=

# Optional. Directory for extraction artifacts and fetch-failure diagnostics.
# SIFT_DEBUG_DIR=./debug/extraction

# Optionally remove if you have your own 
# SearXNG deployment you'd rather use.
COMPOSE_PROFILES=bundled 